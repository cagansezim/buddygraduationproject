@{
    ViewBag.Title = "PetRecord";
    Layout = "~/Views/Shared/Layout/_LayoutClientVet.cshtml";
}
<div class="my-5">
    <div class="card shadow-4 mb-4 w-100 px-4">
        <div class="card-header bg-warning text-white text-left">
            <h3 class="mb-0">Record 1</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- First Column: Medias and Survey Content -->
                <div class="col-md-4">
                    <!-- Medias Section -->
                    <div class="mb-4">
                        <!-- Medias Card -->
                        <div class="card mb-4">
                            <div class="card-header " style="background-color: #f5f5f5;">
                                <h5 class="mb-0">Medias</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex">
                                    <img src="your-image-url.jpg" alt="Pet Image" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover; margin-right: 10px;">
                                    <video src="your-video-url.mp4" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;"></video>
                                </div>
                            </div>
                        </div>

                        <!-- Survey Content Card -->
                        <div class="card">
                            <div class="card-header" style="background-color: #f5f5f5;">
                                <h5 class="mb-0">Survey Content</h5>
                            </div>
                            <div class="card-body">
                                <p><strong>Survey Question:</strong> What is the pet's condition?</p>
                                <p><strong>Answer:</strong> Healthy</p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Second Column: AI Diagnosis inside a Larger Card -->
                <div class="col-md-4">
                    <!-- Larger Card Wrapper -->
                    <div class="card">
                        <div class="card-header text-black" style="background-color: #f5f5f5;">
                            <h5 class="mb-0">AI Diagnosis</h5>
                        </div>
                        <div class="card-body">

                            <!-- AI Diagnosis Card 1 -->
                            <div class="card mb-4">
                                <div class="card-header" style="background-color: #f5f5f5;">
                                    <h6 class="mb-0">Possible Issue 1</h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Description:</strong> The pet shows signs of a potential skin infection.</p>
                                    <p><strong>Possible Treatment:</strong> Antibiotics and topical creams.</p>
                                    <p><strong>Treatment Cost:</strong> $50</p>
                                    <div class="text-end">
                                        <a href="#" class="btn btn-link">See Details</a>
                                    </div>
                                </div>
                            </div>

                            <!-- AI Diagnosis Card 2 -->
                            <div class="card">
                                <div class="card-header" style="background-color: #f5f5f5;">
                                    <h6 class="mb-0">Possible Issue 2</h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Description:</strong> The pet might have a digestive issue causing discomfort.</p>
                                    <p><strong>Possible Treatment:</strong> Dietary changes and hydration therapy.</p>
                                    <p><strong>Treatment Cost:</strong> $30</p>
                                    <div class="text-end">
                                        <a href="#" class="btn btn-link">See Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Third Column: Vet Diagnosis inside a Larger Card -->
                <div class="col-md-4">
                    <!-- Larger Card Wrapper for Vet Diagnosis -->
                    <div class="card">
                        <div class="card-header text-black d-flex justify-content-between align-items-center" style="background-color: #f5f5f5;">
                            <h5 class="mb-0">Vet Diagnosis</h5>
                            <a href="#" class="text-black ms-auto">
                                <i class="fas fa-edit"></i> <!-- Edit Icon for Veterinary to edit the details -->
                            </a>
                        </div>
                        <div class="card-body">

                            <!-- Diagnosis Overview Card -->
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between" style="background-color: #f5f5f5;">
                                    <h6 class="mb-0">Diagnosis Overview</h6>
                                    <span class="text-muted ms-auto">12/04/2025</span> <!-- Date in dd/mm/yyyy format -->
                                </div>
                                <div class="card-body">
                                    <p><strong>Veterinary Clinic:</strong> PetCare Clinic</p>
                                    <p><strong>Veterinary Name:</strong> Dr. John Smith</p>
                                    <p><strong>Description:</strong> The pet is suffering from mild arthritis. Treatment is recommended to improve mobility.</p>
                                    <p><strong>Treatment:</strong> Joint supplements and physical therapy.</p>
                                    <p><strong>Treatment Cost:</strong> $120</p>
                                    <div class="text-end">
                                        <a href="#" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-paperclip"></i> Treatment Documents
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

