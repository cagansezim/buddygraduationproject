@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/Layout/_LayoutClientVet.cshtml";
}

<div class="container py-4">

    <!-- Filter Bar -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="d-flex">
                <input type="text" class="form-control" placeholder="Search by name, species, or owner..." />
                <button class="btn btn-outline-primary ms-2 d-flex align-items-center">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </div>
    </div>


    <div class="container-fluid" data-aos="fade-up" data-aos-delay="100">
    <!-- Customer Cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 gy-4 gx-3" style="max-height: 600px; overflow-y: auto;">
        @for (int i = 0; i < 6; i++)
        {
            bool isUnregistered = i % 2 == 0;
            string customerName = isUnregistered ? "Jane Doe" : "John Smith";
            string pets = isUnregistered ? "None" : "Bella, Max";
            string phone = isUnregistered ? "—" : "+1 234 567 890";
            string statusBadge = isUnregistered
                ? "<span class='badge bg-danger'>Unregistered</span>"
                : "<span class='badge bg-success'>Registered</span>";

                <div class="col">
                    <div class="card shadow-sm p-3" style="width: 350px; height: 200px; background-color: #f8f9fa;">
                        <div class="card-body d-flex flex-column justify-content-between h-100">
                            <!-- Info -->
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">@customerName</h5>
                                @Html.Raw(statusBadge)
                                </div>

                                <p class="mb-1"><strong>Pets:</strong> @pets</p>
                                <p class="mb-1"><strong>Phone:</strong> @phone</p>
                            </div>

                            <!-- Buttons -->
                            <div class="text-end">
                                <a href="#" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i> 
                                </a>
                                <a href="#" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> 
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
        }
    </div>
    </div>
</div>
<section id="pagination-2" class="pagination-2 section">
    <div class="container">
        <div class="d-flex justify-content-center">
            <ul>
                <li><a href="#"><i class="bi bi-chevron-left"></i></a></li>
                <li><a href="#">1</a></li>
                <li><a href="#" class="active">2</a></li>
                <li><a href="#">3</a></li>
                <li><a href="#">4</a></li>
                <li>...</li>
                <li><a href="#">10</a></li>
                <li><a href="#"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </div>
    </div>
</section>

