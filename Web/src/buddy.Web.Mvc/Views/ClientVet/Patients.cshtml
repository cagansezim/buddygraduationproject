@{
   ViewBag.Title = "Patients";
   Layout = "~/Views/Shared/Layout/_LayoutClientVet.cshtml";
}

<!-- Filter Input -->
<div class="container my-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="d-flex">
                <input type="text" class="form-control" placeholder="Search by name, species, or owner..." />
                <button class="btn btn-outline-primary ms-2 d-flex align-items-center">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </div>
    </div>

   <div class="container-fluid" data-aos="fade-up" data-aos-delay="100">
   <!-- Patient Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @for (int i = 0; i < 6; i++)
            {
                bool isUnregistered = i % 3 == 0; // Mock data: every third pet has no owner
                string ownerName = isUnregistered ? "—" : "John Doe";
                string cardBorder = isUnregistered ? "border-danger" : "border-success";
                string statusBadge = isUnregistered
                ? "<span class='badge bg-danger'>Unregistered</span>"
                : "<span class='badge bg-success'>Registered</span>";

                <div class="col p-2">
                    <!-- Wrap the entire card in an anchor tag to make it clickable -->
                    <a href="@Url.Action("PetProfile", "ClientVet")" class="text-decoration-none" style="color: black;">
                        <div class="card shadow-sm p-3" style="width: 350px; height: 250px; background-color: #f5f5f5;">
                            <div class="d-flex h-100">
                                <!-- Pet Image -->
                                <img src="~/assets/img/pet-placeholder.jpg" class="rounded-start" alt="Pet Image"
                                     style="width: 130px; height: 100%; object-fit: cover;" />

                                <!-- Info -->
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h5 class="card-title mb-0" style="color: black;">
                                                Buddy
                                            </h5>
                                            @Html.Raw(statusBadge)
                                        </div>

                                        <p class="mb-1" style="color: black;"><strong>Age:</strong> 2</p>
                                        <p class="mb-1" style="color: black;"><strong>Gender:</strong> Male</p>
                                        <p class="mb-1" style="color: black;"><strong>Species:</strong> Dog</p>
                                        <p class="mb-1" style="color: black;"><strong>Owner:</strong> @ownerName</p>
                                    </div>

                                    <div class="text-end">
                                        <a href="#" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>


</div>
<section id="pagination-2" class="pagination-2 section">
    <div class="container">
        <div class="d-flex justify-content-center">
            <ul>
                <li><a href="#"><i class="bi bi-chevron-left"></i></a></li>
                <li><a href="#">1</a></li>
                <li><a href="#" class="active">2</a></li>
                <li><a href="#">3</a></li>
                <li><a href="#">4</a></li>
                <li>...</li>
                <li><a href="#">10</a></li>
                <li><a href="#"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </div>
    </div>
</section>

