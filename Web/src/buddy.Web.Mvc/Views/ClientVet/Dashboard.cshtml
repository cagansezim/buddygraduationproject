@{
    Layout = "~/Views/Shared/Layout/_LayoutClientVet.cshtml";
    ViewBag.Title = "Dashboard";
}

<style>
    .appointment-table-container {
        overflow-x: auto;
        max-width: 100%;
    }

    .appointment-table-scrollable {
        overflow-y: auto;
        max-height: 500px;
        border: 1px solid #ccc;
    }

    .appointment-table {
        border-collapse: collapse;
        width: 100%;
        min-width: 900px;
    }

        .appointment-table th, .appointment-table td {
            border: 6px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        .appointment-table th {
            background-color: #f5f5f5;
            font-weight: bold;
        }

    .appointment-slot {
        cursor: pointer;
        background-color: #fafafa;
    }

        .appointment-slot:hover {
            background-color: #e8f0fe;
        }
</style>
<div class="container-fluid" data-aos="fade-up" data-aos-delay="100">
<div class="appointment-table-container">
    <div class="appointment-table-scrollable">
        <table class="appointment-table">
            <thead>
                <tr>
                    <th>Hour</th>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                </tr>
            </thead>
            <tbody>
                @for (int hour = 8; hour <= 17; hour++)
                {
                    <tr>
                        <td>@hour:00</td>
                        @for (int day = 0; day < 5; day++) // 0 = Monday, ..., 4 = Friday
                        {
                            <td class="appointment-slot" onclick="onSlotClick('@hour', '@day')">
                                <!-- Empty slot, click to add appointment -->
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function onSlotClick(hour, day) {
        alert(`Clicked slot: ${hour}:00 on day ${parseInt(day) + 1}`);
        // You can open a modal or redirect here
    }
</script>

<div class="mt-5">
    <h1 class="text-center mb-4">Clinic Revenue</h1>
    <canvas id="clinicRevenueChart" height="100"></canvas>
</div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('clinicRevenueChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
                datasets: [{
                    label: 'Revenue (USD)',
                    data: [3200, 4500, 2100, 3800, 5200, 2500, 3300, 1450, 4400, 3150],
                    backgroundColor: '#4e73df'
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}


    
</div>