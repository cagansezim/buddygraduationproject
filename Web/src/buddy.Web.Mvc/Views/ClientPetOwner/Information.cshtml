@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "Information";
    ViewBag.BodyClass = "information-page";
}

<!-- About Section -->
<main class="main">

    <!-- Blog Hero Section -->
    <section id="blog-hero" class="blog-hero section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Featured Post (Large) -->
            <div class="card mx-auto shadow-lg border-0 text-center" style="max-width: 100%; overflow: hidden; border-radius: 15px;">
                <img src="~/assets/img/pixlr-image-generator-a69ebf03-bded-4137-8147-d763a87110df.png"
                     class="card-img-top img-fluid"
                     alt="Featured Post Image"
                     style="object-fit: cover; aspect-ratio: 16/9;">

                <div class="card-body">
                    <h2 class="fw-bold text-secondary">Welcome to Buddy</h2>
                </div>
            </div>



    </section><!-- /Blog Hero Section -->

    <section id="about" class="about section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <span class="section-badge"><i class="bi bi-info-circle"></i> About Application</span>
            <div class="row">
                <div class="col-lg-6">
                    <h2 class="about-title">What is Buddy App?</h2>
                    <p class="about-description">
                        Buddy is an AI-driven pet disease diagnosis and treatment management tool designed to assist pet owners and veterinarians in identifying and managing potential health issues in cats and dogs.
                        By leveraging AI technology, Buddy provides fast and accurate health assessments based on images, videos, and survey inputs.
                    </p>
                </div>
                <div class="col-lg-6">
                    <p class="about-text">
                        The Buddy app offers multiple features, including AI-based preliminary diagnosis, veterinary-assisted diagnosis, and comparative insights from similar cases.
                        Pet owners can use the system to analyze symptoms, receive possible disease predictions, and connect with professional veterinarians for further consultation.
                    </p>
                    <p class="about-text">
                        In addition to health diagnostics, Buddy also helps pet owners manage veterinary appointments, receive pet care reminders, and explore pet adoption opportunities.
                        With its intuitive design and real-time AI support, Buddy makes pet care easier, faster, and more efficient.
                    </p>
                </div>
            </div>

            <div class="row features-boxes gy-4 mt-3">
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-box">
                        <div class="icon-box">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <h3><a>AI-Driven Diagnosis</a></h3>
                        <p>Buddy predicts potential pet diseases by analyzing images, videos, and survey data, helping pet owners take proactive measures.</p>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-box">
                        <div class="icon-box">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <h3><a>Vet-Assisted Diagnosis</a></h3>
                        <p>Pet owners can connect with veterinarians to refine AI-based diagnoses and get expert treatment recommendations.</p>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-box">
                        <div class="icon-box">
                            <i class="bi bi-clipboard-data"></i>
                        </div>
                        <h3><a>Pet Care Management</a></h3>
                        <p>Buddy helps manage pet schedules, track health records, and provides alerts for vaccinations and upcoming veterinary visits.</p>
                    </div>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-lg-12" data-aos="zoom-in" data-aos-delay="200">
                    <div class="video-box">
                        <img src="~/assets/img/black-white-cat.png" class="img-fluid" alt="Buddy Video" style="width: 100%; height:50%; display: block;">
                        <a href="https://youtu.be/G_O535JTYno?feature=shared" class="glightbox pulsating-play-btn"></a>
                    </div>
                </div>
            </div>


        </div>

    </section>
</main>