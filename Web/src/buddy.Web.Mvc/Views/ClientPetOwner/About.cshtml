@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "About";
    ViewBag.BodyClass = "about-page";
}

<!-- Page Title -->
<div class="page-title">
    <div class="title-wrapper">
        <h1>About Us</h1>
        <p>Learn more about Buddy and our mission to help pets and their owners.</p>
    </div>
</div>

<!-- About Section -->
<section id="about" class="about section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <img src="/assets/img/pixlr-image-generator-a69ebf03-bded-4137-8147-d763a87110df.png" class="img-fluid" alt="">
            </div>
            <div class="col-lg-6 pt-4 pt-lg-0 content">
                <h3>We are dedicated to making pet care easier for everyone.</h3>
                <p class="fst-italic">
                    At Buddy, we believe every pet deserves a loving home and the best care possible.
                </p>
                <ul>
                    <li><i class="bi bi-check-circle"></i> <span>Helping pet owners manage their pets with ease.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Connecting pets with loving families through adoptions.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Providing resources to find the best veterinary care.</span></li>
                </ul>
                <p>
                    Our platform is designed to bring pet owners together, offering tools and services to ensure your pets live happy, healthy lives.
                </p>
            </div>
        </div>
    </div>
</section>