@model Abp.Application.Services.Dto.PagedResultDto<buddy.Pets.Dtos.PetDto>
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "My Pets";
}

<main class="main">
    <div class="container mt-4">
        <!-- Page Title -->
        <div class="page-title">
            <div class="title-wrapper text-center">
                <h1>My Pets</h1>
                <p>Manage and view your pets.</p>
            </div>
        </div>

        <!-- Add Pet Button -->
        <div class="text-end mb-4">
            <a href="@Url.Action("Create", "ClientPets")" class="btn btn-secondary btn-lg rounded-pill shadow-sm" id="lets-start-btn">
                <i class="bi bi-plus-lg"></i> Add Pet
            </a>
        </div>

        <!-- Pets List -->
        <div class="row mt-4 gy-4">
            @if (Model.Items.Any())
            {
                foreach (var pet in Model.Items)
                {
                    <div class="col-lg-6">
                        <div class="pet-card position-relative text-center shadow-sm p-4">
                            <div class="pet-actions position-absolute top-0 end-0 mt-2 me-2">
                                <a href="@Url.Action("Edit", "ClientPets", new { id = pet.Id })" class="btn btn-sm me-1 rounded-pill" id="edit-delete-btn">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-controller="ClientPets" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @pet.Name?');">
                                    <input type="hidden" name="id" value="@pet.Id" />
                                    <button type="submit" class="btn btn-sm rounded-pill" id="edit-delete-btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                            <a href="@Url.Action("Details", "ClientPets", new { id = pet.Id })" class="d-block pet-link">
                                <div class="pet-img">
                                    @if (pet.ImageBase64 != null)
                                    {
                                        <img src="data:image/jpeg;base64,@pet.ImageBase64" class="img-fluid rounded-circle" alt="@pet.Name" />
                                    }
                                    else
                                    {
                                        <img src="~/assets/img/default-pet.jpg" class="img-fluid rounded-circle" alt="Default Pet" />
                                    }
                                </div>
                                <h3 class="mt-3">@pet.Name</h3>
                                <p><strong>Species:</strong> @pet.Species | <strong>Race:</strong> @(pet.Breed ?? "N/A")</p>
                                <p><strong>Sex:</strong> @(pet.Sex ?? "N/A") | <strong>Age:</strong> @pet.Age Years</p>
                                <p><strong>Height:</strong> @pet.Height cm | <strong>Weight:</strong> @pet.Weight kg</p>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center rounded-4 shadow-sm">
                        No pets yet. Start by clicking the <strong>Add Pet</strong> button!
                    </div>
                </div>
            }
        </div>
    </div>
</main>
