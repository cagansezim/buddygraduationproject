@using buddy.Web.Startup
@model IEnumerable<buddy.Pets.Dtos.PetDto>
@{
    ViewBag.Title = L("Pets");
    ViewBag.CurrentPageName = PageNames.Pets;
}

@section scripts {
    <environment names="Development">
        <script src="~/view-resources/Views/Pets/Index.js" asp-append-version="true"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Pets/Index.min.js" asp-append-version="true"></script>
    </environment>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Pets")</h1>
            </div>
            <div class="col-sm-6">
                <a href="javascript:;" data-toggle="modal" data-target="#PetCreateModal" class="btn bg-blue float-sm-right">
                    <i class="fa fa-plus-square"></i>
                    @L("Create")
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <!-- Optional: Add search/filter controls here if needed -->
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="PetsTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th class="control"></th>
                                        <th>@L("Name")</th>
                                        <th>@L("Species")</th>
                                        <th>@L("Age")</th>
                                        <th>@L("Breed")</th>
                                        <th>@L("OwnerId")</th>
                                        <th style="width: 150px">@L("Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Data loaded via AJAX -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/Pets/_CreateModal.cshtml", new buddy.Pets.Dtos.CreatePetDto())

<div class="modal fade" id="PetEditModal" tabindex="-1" role="dialog" aria-labelledby="PetEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <!-- Edit form loaded via AJAX -->
        </div>
    </div>
</div>
