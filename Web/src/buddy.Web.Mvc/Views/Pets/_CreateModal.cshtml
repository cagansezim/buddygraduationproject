@using buddy.Web.Models.Common.Modals
@model buddy.Pets.Dtos.CreatePetDto
@{
    Layout = null;
}
<div class="modal fade" id="PetCreateModal" tabindex="-1" role="dialog" aria-labelledby="PetCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("CreateNewPet")))
            <form id="PetCreateForm" asp-action="Create" asp-controller="Pets" class="form-horizontal">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label" for="petName">@L("Name")</label>
                        <div class="col-md-9">
                            <input id="petName" type="text" name="Name" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label" for="petSpecies">@L("Species")</label>
                        <div class="col-md-9">
                            <input id="petSpecies" type="text" name="Species" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label" for="petAge">@L("Age")</label>
                        <div class="col-md-9">
                            <input id="petAge" type="number" name="Age" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label" for="petBreed">@L("Breed")</label>
                        <div class="col-md-9">
                            <input id="petBreed" type="text" name="Breed" class="form-control" required />
                        </div>
                    </div>
                    @* Removed the hidden OwnerId field because it will be set server-side *@
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>
