@using buddy.Web.Models.Common.Modals
@model buddy.Pets.Dtos.PetDto
@{
    Layout = null;
}
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("EditPet")))
<form asp-action="Edit" asp-controller="Pets" method="post" 
      data-ajax="true" 
      data-ajax-success="onEditSuccess" 
      data-ajax-mode="replace" 
      class="form-horizontal">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="modal-body">
        <div class="form-group row required">
            <label class="col-md-3 col-form-label" for="petName">@L("Name")</label>
            <div class="col-md-9">
                <input id="petName" type="text" name="Name" value="@Model.Name" class="form-control" required />
            </div>
        </div>
        <div class="form-group row required">
            <label class="col-md-3 col-form-label" for="petSpecies">@L("Species")</label>
            <div class="col-md-9">
                <input id="petSpecies" type="text" name="Species" value="@Model.Species" class="form-control" required />
            </div>
        </div>
        <div class="form-group row required">
            <label class="col-md-3 col-form-label" for="petAge">@L("Age")</label>
            <div class="col-md-9">
                <input id="petAge" type="number" name="Age" value="@Model.Age" class="form-control" required />
            </div>
        </div>
        <div class="form-group row required">
            <label class="col-md-3 col-form-label" for="petBreed">@L("Breed")</label>
            <div class="col-md-9">
                <input id="petBreed" type="text" name="Breed" value="@Model.Breed" class="form-control" required />
            </div>
        </div>
        <div class="form-group row required">
            <label class="col-md-3 col-form-label" for="petOwnerId">@L("OwnerId")</label>
            <div class="col-md-9">
                <input id="petOwnerId" type="number" name="OwnerId" value="@Model.OwnerId" class="form-control" required />
            </div>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>

<script>
    function onEditSuccess(response) {
        if (response.success) {
            $('#PetEditModal').modal('hide');
            location.reload();
        }
    }
</script>
