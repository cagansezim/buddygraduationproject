@model buddy.Adoptions.Dtos.CreateAdoptionDto
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "Create New Adoption";
    // Get the current user's pets (must be passed via ViewBag in the controller)
    var pets = ViewBag.UserPets as List<buddy.Pets.Dtos.PetDto>;
}

<section class="py-5 bg-light">
    <div class="container">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("MyAdoptions", "ClientAdoptions")">My Adoptions</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Create New Adoption</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-primary text-white py-3 rounded-top">
                <h4 class="mb-0">List Your Pet for Adoption</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" asp-controller="ClientAdoptions" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- Pet Selection Cards -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Choose a Pet to List for Adoption</label>
                        <div class="row g-4">
                            @if (pets != null && pets.Count > 0)
                            {
                                foreach (var pet in pets)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <!-- Wrap the radio input with the card label -->
                                        <label class="pet-card card h-100 shadow-sm border-0 rounded-3 overflow-hidden d-block position-relative @(Model.PetId == pet.Id ? "border border-3 border-primary" : "")">
                                            <input type="radio" name="PetId" value="@pet.Id" class="form-check-input position-absolute top-0 end-0 m-2" style="z-index:2;" @(Model.PetId == pet.Id ? "checked" : "") />
                                            @if (pet.Image != null)
                                            {
                                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(pet.Image)" class="card-img-top object-fit-cover" style="height: 180px;" alt="@pet.Name" />
                                            }
                                            else
                                            {
                                                <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 180px;">
                                                    <i class="bi bi-image fs-1 text-white"></i>
                                                </div>
                                            }
                                            <div class="card-body text-center">
                                                <h5 class="card-title mb-1 text-primary fw-bold">@pet.Name</h5>
                                                <p class="card-text small text-muted">@pet.Species - @pet.Breed</p>
                                                <p class="card-text small text-muted">Age: @pet.Age years</p>
                                            </div>
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="alert alert-warning rounded shadow-sm mt-2">
                                        You don’t have any pets yet. Please add one first.
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="PetId" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe your pet and why it’s being put up for adoption..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Image Upload (optional) -->
                    <div class="mb-3">
                        <label class="form-label">Pet Image</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                        <small class="form-text text-muted">Upload a clear image of your pet (optional)</small>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a href="@Url.Action("MyAdoptions", "ClientAdoptions")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Create Adoption</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            // When any radio input changes, remove the highlight from all and add it to the current card
            $('.pet-card input[type="radio"]').on('change', function () {
                $('.pet-card').removeClass('border border-3 border-primary');
                if (this.checked) {
                    $(this).closest('.pet-card').addClass('border border-3 border-primary');
                }
            });

            // Make entire card clickable
            $('.pet-card').on('click', function (e) {
                if (!$(e.target).is('input[type="radio"]')) {
                    var radio = $(this).find('input[type="radio"]');
                    radio.prop('checked', true).trigger('change');
                }
            });
        });
    </script>
    <style>
        .pet-card {
            cursor: pointer;
            transition: box-shadow 0.2s ease-in-out;
        }

            .pet-card:hover {
                box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            }
    </style>
}
