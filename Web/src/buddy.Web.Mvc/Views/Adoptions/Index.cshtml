@using buddy.Web.Startup
@model IEnumerable<buddy.Adoptions.Dtos.AdoptionDto>

@{
    ViewBag.Title = L("Adoptions");
    ViewBag.CurrentPageName = PageNames.Adoptions;
}

@section scripts {
    <environment names="Development">
        <script src="~/view-resources/Views/Adoptions/Index.js" asp-append-version="true"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Adoptions/Index.min.js" asp-append-version="true"></script>
    </environment>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Adoptions")</h1>
            </div>
            <div class="col-sm-6">
                <a href="javascript:;" data-toggle="modal" data-target="#AdoptionCreateModal" class="btn bg-blue float-sm-right">
                    <i class="fa fa-plus-square"></i>
                    @L("Create")
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <!-- Optional: Search or filter controls -->
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="AdoptionsTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th class="control"></th>
                                        <th>@L("Pet ID")</th>
                                        <th>@L("Clinic ID")</th>
                                        <th>@L("Pet Owner ID")</th>
                                        <th>@L("Description")</th>
                                        <th style="width: 150px">@L("Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Data will be dynamically loaded via AJAX -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Create Modal -->
@await Html.PartialAsync("~/Views/Adoptions/_CreateModal.cshtml", new buddy.Adoptions.Dtos.CreateAdoptionDto())

<!-- Edit Modal -->
<div class="modal fade" id="AdoptionEditModal" tabindex="-1" role="dialog" aria-labelledby="AdoptionEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <!-- Edit form will be dynamically loaded via AJAX -->
        </div>
    </div>
</div>
