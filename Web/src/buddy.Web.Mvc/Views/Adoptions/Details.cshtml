@model buddy.Adoptions.Dtos.AdoptionDto
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = $"{Model.PetName} - Adoption Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "ClientAdoptions")">Adoptions</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>

            <!-- Adoption Details Card -->
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="row g-0">
                    <!-- Left: Image Display -->
                    <div class="col-md-6">
                        @if (!string.IsNullOrEmpty(Model.ImageBase64))
                        {
                            <img src="data:image/jpeg;base64,@Model.ImageBase64" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@Model.PetName" />
                        }
                        else
                        {
                            <div class="bg-secondary d-flex justify-content-center align-items-center h-100" style="min-height: 300px;">
                                <i class="bi bi-image fs-1 text-white"></i>
                            </div>
                        }
                    </div>
                    <!-- Right: Adoption Information -->
                    <div class="col-md-6">
                        <div class="card-body p-4">
                            <h2 class="card-title fw-bold mb-1">@Model.PetName</h2>
                            <p class="text-muted mb-3">@Model.Species • @Model.Race</p>
                            
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Age</small>
                                    <span class="fw-bold">@Model.Age years</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Weight</small>
                                    <span class="fw-bold">@Model.Weight kg</span>
                                </div>
                                <div class="col-6 mt-2">
                                    <small class="text-muted d-block">Height</small>
                                    <span class="fw-bold">@Model.Height cm</span>
                                </div>
                                <div class="col-6 mt-2">
                                    <small class="text-muted d-block">Vaccinated</small>
                                    <span class="fw-bold">@(Model.Is_vaccinated ? "Yes" : "No")</span>
                                </div>
                            </div>

                            <h5 class="mb-2">Description</h5>
                            <p class="card-text">@Model.Description</p>
                            
                            <hr class="my-4" />
                            
                            <div class="d-flex align-items-center mb-3">
                                <p class="mb-0 text-muted"><strong>Owner:</strong> @Model.PetOwnerName</p>
                            </div>
                            
                            <div class="d-flex justify-content-end gap-2">
                                <a href="@Url.Action("Edit", "ClientAdoptions", new { id = Model.Id })" class="btn btn-outline-primary rounded-pill px-4">Edit</a>
                                <form asp-action="Delete" asp-controller="ClientAdoptions" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div><!-- /row g-0 -->
            </div><!-- /card -->
        </div><!-- /col-lg-8 -->
    </div><!-- /row -->
</div><!-- /container -->
