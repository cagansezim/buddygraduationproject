@model IList<buddy.Records.Dtos.RecordDto>
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "My AI Diagnoses";
}

<style>
    .hover-scale {
        transition: transform .15s
    }

    .hover-scale:hover {
        transform: translateY(-4px) scale(1.02)
    }</style>

<div class="container py-5">

    <h2 class="text-center fw-bold mb-5">
        <i class="bi bi-clock-history text-primary"></i> My AI Diagnoses
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">You haven’t run any AI analyses yet.</div>
        <div class="text-center">
            <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Run First Analysis</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model.OrderByDescending(x => x.Created_at))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-scale">

                        <div class="card-header bg-primary text-white rounded-top-4 py-2">
                            <h6 class="mb-0 fw-semibold">@r.Name</h6>
                        </div>

                        <div class="card-body small">
                            <p class="mb-1"><strong>Date:</strong> @r.Created_at.ToString("yyyy-MM-dd HH:mm")</p>
                            <p class="mb-1 text-truncate"><strong>Description:</strong> @r.Description</p>

                            @if (!string.IsNullOrWhiteSpace(r.ImageBase64))
                            {
                                <img class="img-fluid rounded-3 mt-2"
                                     src="@r.ImageBase64" alt="thumb">
                            }
                        </div>

                        <div class="card-footer bg-white border-0 text-end">
                            <a asp-action="Details"
                               asp-route-id="@r.Id"
                               class="btn btn-outline-primary btn-sm">
                                View Details <i class="bi bi-arrow-right-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
