<!DOCTYPE html>
<style>
    .right-sidebar {
        position: fixed;
        top: 0;
        right: -350px; /* hidden by default */
        width: 350px;
        height: 100%;
        transition: right 0.3s ease-in-out;
        z-index: 1045;
        overflow-y: auto;
    }

        .right-sidebar.active {
            right: 0;
        }

    .toggle-sidebar-btn {
        position: fixed;
        top: 50%;
        right: 0;
        transform: translate(100%, -50%);
        z-index: 1050;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

</style>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - BUDDY</title>

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon" />
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Nunito:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet" />
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />

    <!-- Main CSS File -->
    <link href="~/assets/css/main.css" rel="stylesheet" />

    <!-- ABP Styles -->
    @await Html.PartialAsync("~/Views/Shared/Layout/_Styles.cshtml")
    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.3.0/mdb.min.css" rel="stylesheet" />

</head>
<body class="@(ViewBag.BodyClass ?? "dashboard-page")">
    <header id="header" class="header position-relative">
        <div class="container-fluid container-xl position-relative">
            <div class="top-row d-flex align-items-center justify-content-between">
                <a href="@Url.Action("Dashboard", "ClientVet")" class="logo d-flex align-items-end">
                    <h1 class="sitename">BUDDY</h1><span>.</span>
                </a>

                <!-- Search Bar -->
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <form class="search-form d-flex" asp-action="Search" asp-controller="ClientVet" method="get">
                            <input type="text" name="query" class="form-control flex-grow-1" placeholder="Search..." />
                            <button type="submit" class="btn btn-primary ms-2"><i class="bi bi-search"></i></button>
                        </form>
                    </div>
                </div>


                <!-- Profile picture trigger for sidebar -->
                <!-- Custom User Area -->
                <div class="ms-auto d-flex align-items-center position-relative gap-3">

                    <!-- Profile Picture -->
                    <div id="profilePicBtn" style="cursor: pointer;">
                        <img src="@(!string.IsNullOrEmpty(ViewBag.UserPhotoUrl)
                    ? Url.Content(ViewBag.UserPhotoUrl)
                    : Url.Content("~/assets/img/user-placeholder.png"))"
                             class="rounded-circle border border-light" width="40" height="40" alt="User Picture" />
                    </div>
                </div>


                <!-- ABP Language Switch -->
                @await Component.InvokeAsync("RightNavbarLanguageSwitch")
            </div>
        </div>
        </div>
        </div>
        </div>

        <div class="nav-wrap">
            <div class="container d-flex justify-content-center position-relative">
                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="@Url.Action("Dashboard", "ClientVet")">Dashboard</a></li>
                        <li><a href="@Url.Action("Appointments", "ClientVet")">Appointments</a></li>
                        <li><a href="@Url.Action("Patients", "ClientVet")">Patients</a></li>
                        <li><a href="@Url.Action("Customers", "ClientVet")">Customers</a></li>
                        <li><a href="@Url.Action("Requests", "ClientVet")">Requests</a></li>
                        <li><a href="@Url.Action("Adoptions", "ClientVet")">Adoptions</a></li>
                    </ul>
                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                </nav>
            </div>
        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>
    <!-- Right Sidebar -->
    <div id="rightSidebar" class="right-sidebar bg-light border-start shadow-sm fs-5">
        <div class="p-4 text-center">
            <img src="~/assets/img/user-placeholder.png" class="rounded-circle mb-2" width="80" height="80" alt="User Image" />
            <h5 class="mb-0 fs-4">@User.Identity.Name</h5>
            <small class="text-muted">Veterinarian</small>
        </div>

        <ul class="nav flex-column px-3">
            <li class="nav-item">
                <a class="nav-link text-dark" href="@Url.Action("VetProfile", "ClientVet")">
                    <i class="bi bi-person me-2"></i>My Profile
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link text-dark" href="@Url.Action("Clinic", "ClientVet")">
                    <i class="bi bi-building me-2"></i>My Clinic
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="@Url.Action("VetRecords", "ClientVet")">
                    <i class="bi bi-journal-medical me-2"></i>My Records
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="@Url.Action("Settings", "ClientVet")">
                    <i class="bi bi-gear me-2"></i>Settings
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="@Url.Action("Help", "ClientVet")">
                    <i class="bi bi-question-circle me-2"></i>Help
                </a>
            </li>
            <li class="nav-item mt-3">
                <a class="nav-link text-danger" href="@Url.Action("Logout", "Account")">
                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                </a>
            </li>
        </ul>
    </div>

    <!-- Sidebar Toggle Button -->
    <button id="toggleSidebar" class="btn btn-primary toggle-sidebar-btn" title="Toggle Sidebar">
        <i class="bi bi-layout-sidebar-inset-reverse"></i>
    </button>

    <footer id="footer" class="footer">
        <div class="container copyright text-center mt-4">
            <p>© <span>2025</span> <strong class="px-1 sitename">BUDDY</strong> <span>All Rights Reserved</span></p>
        </div>
    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>

    <!-- Main JS File -->
    <script src="~/assets/js/main.js"></script>

    <!-- ABP Scripts -->
    @await Html.PartialAsync("~/Views/Shared/Layout/_Scripts.cshtml")

    <!-- FullCalendar JS -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>


    @RenderSection("Scripts", required: false)
    <script>
        const profilePic = document.getElementById('profilePicBtn');
        const sidebar = document.getElementById('rightSidebar');

        // Toggle sidebar when clicking the profile picture
        profilePic?.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent triggering the outside click
            sidebar.classList.toggle('active');
        });

        // Prevent clicks inside sidebar from closing it
        sidebar?.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Close sidebar when clicking anywhere outside
        document.addEventListener('click', (e) => {
            if (sidebar?.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });
    </script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.3.0/mdb.min.js"></script>
</body>
</html>