@model string
@{
    ViewBag.Title = "Error";
    ViewBag.CurrentPageName = "ImageClassification";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark">Error</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible alert-custom">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                    <h5><i class="icon fas fa-exclamation-triangle"></i> Error</h5>
                    @Model
                </div>
                <a asp-action="Index" class="btn btn-primary btn-custom">Back to Classification</a>
            </div>
        </div>
    </div>
</section>