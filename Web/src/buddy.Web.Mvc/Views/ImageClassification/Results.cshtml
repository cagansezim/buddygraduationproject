@model List<buddy.AI.ImageClassification.Dto.ImageClassificationResultDto>;
@{
    ViewBag.Title = "Classification Results";
    ViewBag.CurrentPageName = "ImageClassification";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark">Classification Results</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Classified Images</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model == null || !Model.Any())
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i> No images were classified.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Classification</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var result in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(result.ImageBytes)" alt="Classified Image" class="image-preview" />
                                                </td>
                                                <td>
                                                    <span class="badge badge-@(result.Classification == "cat" ? "info" : "success")">
                                                        @result.Classification
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Index" class="btn btn-primary btn-custom">Back to Classification</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>