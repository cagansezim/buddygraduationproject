@model buddy.AI.ImageClassification.Dto.ImageClassificationResultDto;
@{
    ViewBag.Title = "Single Image Classification Result";
    ViewBag.CurrentPageName = "ImageClassification";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark">Single Image Classification Result</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6 offset-md-3">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Classification Result</h3>
                    </div>
                    <div class="card-body text-center">
                        @if (Model == null)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i> No classification result available.
                            </div>
                        }
                        else
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageBytes)" alt="Classified Image" style="max-width: 100%; max-height: 400px; border-radius: 8px;" />
                            <h5 class="mt-3">Classification: <span class="badge badge-@(Model.Classification == "cat" ? "info" : "success")">@Model.Classification</span></h5>
                        }
                    </div>
                    <div class="card-footer text-center">
                        <a asp-action="Index" class="btn btn-primary btn-custom">Back to Classification</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>