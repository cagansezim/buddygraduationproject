@model Abp.Application.Services.Dto.PagedResultDto<buddy.Appointments.Dtos.AppointmentDto>
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "Appointments";

    // Calculate pagination
    var pageSize = 9; // 3 cards per row × 3 rows
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / pageSize);
    var currentPage = ViewBag.PageNumber ?? 1;
}

<div class="page-title">
    <div class="title-wrapper">
        <h1>Appointments</h1>
        <p>Manage your veterinary appointments.</p>
    </div>
</div>

<section id="appointments" class="section light-background py-5">
    <div class="container">
        <div class="text-end mb-4">
            <a href="@Url.Action("Create", "ClientAppointments")" class="btn btn-secondary btn-lg rounded-pill shadow-sm" id="lets-start-btn"><i class="bi bi-plus-lg"></i> Schedule Appointment</a>
        </div>
        <div class="appointment-list">
            @if (Model.Items.Any())
            {
                <div class="row gy-4">
                    @foreach (var appointment in Model.Items)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-12">
                            <div class="card shadow-sm border-0 rounded-4">
                                <div class="card-body">
                                    <h5 class="card-title">Appointment for Pet ID: @appointment.PetId</h5>
                                    <p class="card-text text-muted">
                                        <strong>Date:</strong> @appointment.ScheduledDateTime.ToString("MMMM dd, yyyy") |
                                        <strong>Time:</strong> @appointment.ScheduledDateTime.ToString("h:mm tt")
                                    </p>
                                    <p class="card-text text-muted"><strong>Clinic ID:</strong> @appointment.ClinicId</p>
                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("Details", "ClientAppointments", new { id = appointment.Id })" class="btn btn-secondary btn-sm rounded-pill">Details</a>
                                        @* Add Edit/Cancel buttons as necessary *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center">
                    <p class="text-muted">No appointments available at the moment.</p>
                </div>
            }
        </div>
        @if (Model.Items.Any())
        {
            <section id="pagination-2" class="pagination-2 section mt-5">
                <div class="container">
                    <div class="d-flex justify-content-center">
                        <ul>
                            <li>
                                <a href="@Url.Action("Index", "ClientAppointments", new { pageNumber = currentPage > 1 ? currentPage - 1 : 1 })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li>
                                    <a href="@Url.Action("Index", "ClientAppointments", new { pageNumber = i })" class="@(i == currentPage ? "active" : "")">@i</a>
                                </li>
                            }
                            <li>
                                <a href="@Url.Action("Index", "ClientAppointments", new { pageNumber = currentPage < totalPages ? currentPage + 1 : totalPages })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </section>
        }
    </div>
</section>