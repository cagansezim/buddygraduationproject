@model buddy.Appointments.Dtos.AppointmentDto
@{
    Layout = "~/Views/Shared/Layout/_LayoutClientPetOwner.cshtml";
    ViewBag.Title = "Appointment Details";
}

<div class="page-title">
    <div class="title-wrapper">
        <h1>Appointment Details</h1>
    </div>
</div>

<section id="appointment-details" class="section">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Appointment for Pet Id: @Model.PetId</h5>
                <p class="card-text">
                    <strong>Date:</strong> @Model.ScheduledDateTime.ToString("MMMM dd, yyyy")<br />
                    <strong>Time:</strong> @Model.ScheduledDateTime.ToString("h:mm tt")<br />
                    <strong>Clinic Id:</strong> @Model.ClinicId<br />
                    <strong>Status:</strong> @Model.Status
                </p>
                @* Add actions like Edit or Cancel *@
                <a href="@Url.Action("Index", "ClientAppointments")" class="btn btn-secondary">Back to Appointments</a>
            </div>
        </div>
    </div>
</section>
